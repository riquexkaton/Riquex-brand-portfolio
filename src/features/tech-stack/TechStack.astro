---
import { tech } from '@/data/tech';
import SectionHeading from '@/ui/SectionHeading.astro';

import TechItem from './TechItem.astro';
---

<section id="tecnologias" class="px-[clamp(1rem,3vw,2.5rem)] pb-[clamp(6rem,14vw,12.5rem)]">
  <SectionHeading title={tech.title} label={tech.label} class="mb-[clamp(2.5rem,6vw,5.5rem)]" />
  <div class="relative border-t border-paper pt-[clamp(1.75rem,3vw,2.75rem)]">
    <p
      data-observe
      class="reveal text-[clamp(2.375rem,5.6vw,6.75rem)] leading-[1.08] font-medium tracking-[-0.05em] text-pretty [&:has([data-tech]:hover)_[data-tech]:not(:hover)]:opacity-22"
    >
      {tech.groups.map(({ label, items }, g) => (
        <span>
          <span class="mt-[0.35em] mr-[0.6em] inline-block align-top font-mono text-[clamp(0.6875rem,0.9vw,0.875rem)] leading-none tracking-[0.06em] text-muted uppercase">{`${String(g + 1).padStart(2, '0')} ${label}`}</span>{' '}
          {items.map((item, i) => (
            <TechItem {...item} last={i === items.length - 1} />
          ))}
        </span>
      ))}
    </p>
  </div>
</section>
