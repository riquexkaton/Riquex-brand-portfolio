---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

import { projects } from '@/data/projects';

interface Props {
  index: number;
  total: number;
  title: string;
  type: string;
  stack: string;
  year: string;
  image: ImageMetadata;
  alt: string;
  url: string;
}

const { index, total, title, type, stack, year, image, alt, url } = Astro.props;
---

<article
  aria-label={projects.carousel.cardLabel(index + 1, total, title)}
  data-active={index === 0 ? '' : undefined}
  style={`--depth:${index % 2 ? 1.35 : 1}`}
  class="relative w-[84vw] flex-none snap-center overflow-hidden bg-panel opacity-35 [transition:opacity_.6s_var(--ease-expo),translate_1.2s_var(--ease-power3)] [translate:calc(var(--px,0)*-120px*var(--depth))_calc(var(--py,0)*-70px*var(--depth))] data-active:opacity-100 md:aspect-16/10 md:w-[min(68vw,80rem,128svh)]"
>
  <Picture
    src={image}
    {alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[480, 800, 1200, 1600, 2000, 2560]}
    sizes="(min-width: 56.25rem) min(68vw, 1280px, 128vh), 84vw"
    loading="lazy"
    decoding="async"
    draggable="false"
    class="block aspect-16/10 w-full object-cover object-top md:absolute md:inset-0 md:h-full"
  />
  <div
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 hidden h-[36%] md:block bg-linear-to-t from-black/85 to-transparent backdrop-blur-[1.125rem] mask-[linear-gradient(to_top,#000_40%,transparent)]"
  ></div>
  <!-- Narrow: caption inside the panel, below the full 16:10 screenshot. Wide: overlaid on the image. -->
  <div class="flex flex-col gap-3.5 border-t border-paper/12 px-[1.125rem] pt-5 pb-[1.375rem] md:absolute md:inset-x-[clamp(1.25rem,2.6vw,2.75rem)] md:bottom-[clamp(1.5rem,3.2vw,3.25rem)] md:flex-row md:items-end md:justify-between md:gap-5 md:border-0 md:p-0">
    <h3 class="text-[1.875rem] leading-[1.05] font-medium tracking-[-0.035em] md:text-[clamp(1.875rem,3.4vw,3.625rem)]">
      {title}
    </h3>
    <p class="flex flex-col gap-1.5 font-mono text-[0.75rem] font-semibold tracking-[0.06em] uppercase md:items-end md:text-right md:text-[clamp(0.8125rem,1vw,1rem)]">
      <span>{`${type} · ${year}`}</span>
      <span class="text-muted">{stack}</span>
    </p>
    <!-- Visible affordance where there is no hover cursor; the overlay link below carries the name. -->
    <span
      aria-hidden="true"
      class="flex items-center gap-2 self-start bg-paper px-3.5 py-3 font-mono text-[0.75rem] leading-none font-semibold tracking-[0.06em] text-black uppercase md:hidden"
    >
      <span>{projects.carousel.visit}</span>
      <span>↗</span>
    </span>
  </div>
  <!-- Covers the whole card. Only the active card is tabbable (carousel.ts keeps it in sync). -->
  <a
    data-visit
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={projects.carousel.visitLabel(title)}
    tabindex={index === 0 ? undefined : -1}
    class="absolute inset-0 z-1 focus-visible:-outline-offset-4 pointer-fine:group-data-[cursor-ready]/carousel:cursor-none"
  ></a>
</article>
