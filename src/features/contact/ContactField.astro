---
import type { ContactFieldName, FieldSpec } from '@/data/contact';
import { contact } from '@/data/contact';
import MonoLabel from '@/ui/MonoLabel.astro';

interface Props {
  name: ContactFieldName;
}

const { name } = Astro.props;
const { label, placeholder, minLength, maxLength, counter }: FieldSpec = contact.fields[name];
const id = `f-${name}`;
const control =
  'w-full rounded-none border-b border-paper/30 bg-transparent py-3 text-[clamp(1.25rem,1.8vw,1.625rem)] tracking-[-0.02em] text-paper outline-none transition-[border-color] duration-300 focus:border-paper aria-invalid:not-focus:border-error';
// The form is novalidate: these attributes carry semantics (and the hard length cap), the script validates.
const shared = {
  id,
  name,
  placeholder,
  required: true,
  minlength: minLength,
  maxlength: maxLength,
  'aria-invalid': 'false' as const,
  'aria-describedby': `${id}-error`,
};
---

<div class="flex flex-col gap-1.5">
  <MonoLabel as="label" for={id}>
    {label}
  </MonoLabel>
  {name === 'message' ? (
    <textarea {...shared} rows="4" class:list={[control, 'resize-y leading-[1.35]']} />
  ) : (
    <input
      {...shared}
      type={name === 'email' ? 'email' : 'text'}
      autocomplete={name}
      inputmode={name === 'email' ? 'email' : undefined}
      class={control}
    />
  )}
  <div class="flex items-start justify-between gap-4">
    <span id={`${id}-error`} aria-live="polite" class="min-h-[1.125rem] text-[0.8125rem] text-error"></span>
    {counter && (
      <span
        id={`${id}-counter`}
        data-near={counter.near}
        aria-hidden="true"
        class="shrink-0 font-mono text-[0.75rem] tracking-[0.04em] text-muted data-[level=max]:text-error data-[level=near]:text-paper"
      >
        {`0/${maxLength}`}
      </span>
    )}
  </div>
</div>
