---
import { about } from '@/data/about';
import MonoLabel from '@/ui/MonoLabel.astro';
import SplitChars from '@/ui/SplitChars.astro';

const columns = 'grid grid-cols-1 md:grid-cols-[minmax(0,3fr)_minmax(0,9fr)]';
---

<section
  id="sobre-mi"
  class:list={[columns, 'gap-x-6 gap-y-8 px-[clamp(1rem,3vw,2.5rem)] py-[clamp(6rem,14vw,12.5rem)]']}
>
  <MonoLabel as="h2" scramble>
    {about.label}
  </MonoLabel>
  <div class="flex flex-col gap-[clamp(3.5rem,7vw,6rem)]">
    <p
      data-scrub
      class="text-[clamp(1.75rem,3.7vw,3.875rem)] leading-[1.08] font-medium tracking-[-0.035em] text-pretty"
    >
      <SplitChars text={about.statement} by="words" mask={false} />
    </p>
    <dl data-observe class="reveal grid grid-cols-[repeat(auto-fit,minmax(12.5rem,1fr))] gap-x-6 gap-y-7">
      {about.facts.map(({ term, detail }) => (
        <div class="flex flex-col gap-2 border-t border-paper/14 pt-4">
          <MonoLabel as="dt">{term}</MonoLabel>
          <dd class="text-[1.125rem]">{detail}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  import './scrub';
</script>
