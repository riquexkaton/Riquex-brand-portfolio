---
import { experience } from '@/data/experience';
import MonoLabel from '@/ui/MonoLabel.astro';
import SectionHeading from '@/ui/SectionHeading.astro';

import ExperienceRow from './ExperienceRow.astro';
import RoleHeading from './RoleHeading.astro';

const { freelance, wingsoft, projects } = experience;
const columns = 'grid grid-cols-1 gap-x-6 gap-y-4 md:grid-cols-[minmax(0,3fr)_minmax(0,9fr)]';
---

<section id="experiencia" class="px-[clamp(1rem,3vw,2.5rem)] pb-[clamp(6rem,14vw,12.5rem)]">
  <SectionHeading title={experience.title} label={experience.label} class="mb-[clamp(2.5rem,6vw,5.5rem)]" />

  <article data-observe class:list={['reveal border-t border-paper pt-7 pb-[clamp(3rem,6vw,5rem)]', columns]}>
    <MonoLabel>{freelance.period}</MonoLabel>
    <div class="flex flex-col gap-3.5">
      <RoleHeading company={freelance.company} role={freelance.role} />
      <p class="max-w-[35rem] text-[1.125rem] leading-normal">{freelance.summary}</p>
    </div>
  </article>

  <article class="border-t border-paper pt-7">
    <div data-observe class:list={['reveal mb-[clamp(2rem,4vw,3.5rem)]', columns]}>
      <MonoLabel>{wingsoft.period}</MonoLabel>
      <div class="flex flex-col gap-3.5">
        <RoleHeading company={wingsoft.company} role={wingsoft.role} />
        <MonoLabel>{wingsoft.projectsLabel}</MonoLabel>
      </div>
    </div>
    <ul>
      {projects.map((project, i) => (
        <ExperienceRow {...project} index={i} />
      ))}
    </ul>
  </article>
</section>
