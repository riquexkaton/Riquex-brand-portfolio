---
interface Props {
  index: number;
  name: string;
  period: string;
  stack: string;
  description: string;
}

const { index, name, period, stack, description } = Astro.props;
---

<li data-observe class="reveal border-t border-paper/14">
  <details
    name="experience"
    class="group details-content:h-0 details-content:overflow-y-clip details-content:transition-[height,content-visibility] details-content:transition-discrete details-content:duration-600 details-content:ease-expo open:details-content:h-auto"
  >
    <summary class="group/row grid cursor-pointer list-none grid-cols-[32px_minmax(0,1fr)_20px] items-center gap-4 py-[clamp(1.125rem,2vw,1.75rem)] md:grid-cols-[72px_minmax(0,1fr)_minmax(0,260px)_180px_20px] [&::-webkit-details-marker]:hidden">
      <span class="font-mono text-[0.75rem] text-muted">{String(index + 1).padStart(2, '0')}</span>
      <span class="flex min-w-0 flex-col gap-1.5">
        <span class="block overflow-x-visible overflow-y-clip text-[clamp(1.875rem,5.2vw,5.5rem)] leading-none font-medium tracking-[-0.05em] transition-[translate] duration-600 ease-expo motion:group-hover/row:translate-x-[14px]">
          <span class="block transition-[translate] duration-1000 ease-expo pending:translate-y-[110%]">{name}</span>
        </span>
        <span class="text-[0.8125rem] text-muted md:hidden">{period}</span>
      </span>
      <span class="hidden text-[0.9375rem] text-muted md:block">{stack}</span>
      <span class="hidden text-right font-mono text-[0.75rem] tracking-[0.04em] text-muted uppercase md:block">
        {period}
      </span>
      <span aria-hidden="true" class="relative size-[1.125rem] justify-self-end">
        <span class="absolute inset-x-0 top-2 h-0.5 bg-paper"></span>
        <span class="absolute inset-y-0 left-2 w-0.5 bg-paper transition-transform duration-450 ease-expo group-open:scale-y-0"></span>
      </span>
    </summary>
    <div class="flex flex-col gap-3 pb-[clamp(1.5rem,3vw,2.5rem)] pl-12 opacity-0 transition-opacity duration-500 group-open:opacity-100 md:pl-[88px]">
      <p class="max-w-[42.5rem] text-[clamp(1.0625rem,1.4vw,1.3125rem)] leading-normal text-pretty">{description}</p>
      <p class="text-[0.875rem] text-muted md:hidden">{stack}</p>
    </div>
  </details>
</li>
