---
import { hero } from '@/data/hero';
---

<a
  href={hero.scroll.href}
  class="absolute inset-x-0 bottom-[clamp(1rem,3svh,2rem)] z-4 mx-auto flex w-max flex-col items-center gap-2.5 hover:text-muted motion:animate-fade-in motion:[--fade-y:18px] motion:[animation-delay:1.52s]"
>
  <span class="font-mono text-[0.6875rem] tracking-[0.08em] uppercase">{hero.scroll.label}</span>
  <span class="flex h-8 w-11 items-center justify-center overflow-hidden">
    <svg
      aria-hidden="true"
      width="16"
      height="24"
      viewBox="0 0 16 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="motion:animate-scroll-hint motion:[animation-delay:2.45s]"
    >
      <line x1="8" y1="1" x2="8" y2="22"></line>
      <polyline points="1,15 8,22 15,15"></polyline>
    </svg>
  </span>
</a>
