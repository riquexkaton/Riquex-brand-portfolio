---
/**
 * Build-time text splitter (replaces GSAP SplitText). Units expose `--i` (their stagger index) to CSS.
 * The text is rendered once, so crawlers read it once. Word splits read naturally; char splits are
 * hidden from assistive tech (letters in inline-block spans can be spelled out), so their parent
 * names the text: SplitTitle sets `aria-label`, and the marquee is decorative.
 */
interface Props {
  text: string;
  by?: 'chars' | 'words';
  /** First `--i` value, to continue a stagger across several splitters. */
  offset?: number;
  /** Wrap each unit in a vertical clip so it can rise from below. */
  mask?: boolean;
  /** Classes for every unit (animations, transitions, delays). */
  unitClass?: string;
}

const { text, by = 'chars', offset = 0, mask = true, unitClass } = Astro.props;

let index = offset;
const words = text
  .split(' ')
  .map((word) => (by === 'chars' ? Array.from(word) : [word]).map((unit) => ({ unit, index: index++ })));
// The extra bottom padding keeps descenders inside the clip without changing the line box.
const maskClass = '-mb-[0.14em] inline-block overflow-x-visible overflow-y-clip pb-[0.14em]';
---

<span aria-hidden={by === 'chars' ? 'true' : undefined}>
  {words.map((units, w) => {
    const rendered = units.map(({ unit, index: i }) => {
      const span = (
        <span data-split-unit class:list={['inline-block', unitClass]} style={`--i:${i}`}>
          {unit}
        </span>
      );
      return mask ? <span class={maskClass}>{span}</span> : span;
    });
    return (
      <>
        {w > 0 && ' '}
        {by === 'chars' ? <span class="inline-block whitespace-nowrap">{rendered}</span> : rendered}
      </>
    );
  })}
</span>
