// Static site on Workers static assets (Cloudflare's recommended setup for new projects).
// public/_headers is applied natively; unknown paths get dist/404.html with a 404 status.
{
  // Must match the Worker connected to the GitHub repo in the Cloudflare dashboard.
  "name": "riquex-brand-portfolio",
  "compatibility_date": "2026-10-01",
  // Custom Domain: deploy creates the DNS record and the certificate.
  "routes": [{ "pattern": "enriqueurdaneta.dev", "custom_domain": true }],
  // Serve only from the custom domain, so workers.dev doesn't duplicate the content.
  "workers_dev": false,
  // Backend for /api/* only (the contact form). Every other path stays a pure static asset.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  // No destination_address: an unrestricted binding can still only reach verified Email Routing
  // destinations. The recipient comes from the CONTACT_TO secret (`wrangler secret put CONTACT_TO`).
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  "vars": {
    // Sender on the Email Routing domain. Not secret: it only appears as the From of the notification.
    "CONTACT_FROM": "contacto@enriqueurdaneta.dev",
  },
  // 3 messages per minute per visitor IP (counted per Cloudflare location).
  "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  // Workers Logs: keeps the Worker's errors (e.g. a failed send) to review in the dashboard.
  // Only /api/* runs the Worker, so the volume stays tiny.
  "observability": { "enabled": true },
}
