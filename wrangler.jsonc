// Static site on Workers static assets (Cloudflare's recommended setup for new projects).
// public/_headers is applied natively; unknown paths get dist/404.html with a 404 status.
{
  // Must match the Worker connected to the GitHub repo in the Cloudflare dashboard.
  "name": "riquex-brand-portfolio",
  "compatibility_date": "2026-10-01",
  // Custom Domain: deploy creates the DNS record and the certificate.
  "routes": [{ "pattern": "enriqueurdaneta.dev", "custom_domain": true }],
  // Serve only from the custom domain, so workers.dev doesn't duplicate the content.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
